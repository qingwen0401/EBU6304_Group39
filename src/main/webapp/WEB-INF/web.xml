<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>TA Recruitment System</display-name>

    <!-- ==================== Listeners ==================== -->
    <listener>
        <listener-class>com.ebu6304.recruitment.web.AppInitializer</listener-class>
    </listener>

    <!-- ==================== Filters ==================== -->
    <!-- Authentication filter: protects all /ta/* pages -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.ebu6304.recruitment.web.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/ta/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/mo/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- ==================== Servlets ==================== -->

    <!-- Login -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.ebu6304.recruitment.web.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Register -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.ebu6304.recruitment.web.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- Logout -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.ebu6304.recruitment.web.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- TA Dashboard -->
    <servlet>
        <servlet-name>TADashboardServlet</servlet-name>
        <servlet-class>com.ebu6304.recruitment.web.servlet.TADashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TADashboardServlet</servlet-name>
        <url-pattern>/ta/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Job Market -->
    <servlet>
        <servlet-name>JobServlet</servlet-name>
        <servlet-class>com.ebu6304.recruitment.web.servlet.JobServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>JobServlet</servlet-name>
        <url-pattern>/ta/jobs</url-pattern>
    </servlet-mapping>

    <!-- Applications -->
    <servlet>
        <servlet-name>ApplicationServlet</servlet-name>
        <servlet-class>com.ebu6304.recruitment.web.servlet.ApplicationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApplicationServlet</servlet-name>
        <url-pattern>/ta/applications</url-pattern>
    </servlet-mapping>

    <!-- TA Profile -->
    <servlet>
        <servlet-name>TAProfileServlet</servlet-name>
        <servlet-class>com.ebu6304.recruitment.web.servlet.TAProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TAProfileServlet</servlet-name>
        <url-pattern>/ta/profile</url-pattern>
    </servlet-mapping>

    <!-- MO Dashboard -->
    <servlet>
        <servlet-name>MODashboardServlet</servlet-name>
        <servlet-class>com.ebu6304.recruitment.web.servlet.MODashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MODashboardServlet</servlet-name>
        <url-pattern>/mo/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Admin Dashboard -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>com.ebu6304.recruitment.web.servlet.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <!-- ==================== Welcome Files ==================== -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ==================== Session Config ==================== -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>



</web-app>
